<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <app name="account" position="inside">
                <block
                    title="Cash Flow Forecast"
                    name="cash_flow_forecast_setting_container"
                >
                    <setting
                        id="cash_flow_horizon"
                        string="Forecast Horizon"
                        company_dependent="1"
                        help="Generated forecast lines reach this many months ahead."
                    >
                        <field name="cash_flow_horizon_months" />
                        <span> months</span>
                    </setting>
                    <setting
                        id="cash_flow_vat"
                        company_dependent="1"
                        help="Forecast the VAT payments of the open and coming VAT periods."
                    >
                        <field name="cash_flow_vat_forecast" />
                        <div
                            class="content-group"
                            invisible="not cash_flow_vat_forecast"
                        >
                            <div class="row mt16">
                                <label
                                    for="cash_flow_vat_period"
                                    class="col-lg-4 o_light_label"
                                />
                                <field name="cash_flow_vat_period" />
                            </div>
                            <div class="row">
                                <label
                                    for="cash_flow_vat_due_months"
                                    class="col-lg-4 o_light_label"
                                />
                                <field name="cash_flow_vat_due_months" />
                            </div>
                            <div class="row">
                                <label
                                    for="cash_flow_vat_due_day"
                                    class="col-lg-4 o_light_label"
                                />
                                <field name="cash_flow_vat_due_day" />
                            </div>
                            <div class="row">
                                <label
                                    for="cash_flow_vat_estimate_periods"
                                    class="col-lg-4 o_light_label"
                                />
                                <field name="cash_flow_vat_estimate_periods" />
                            </div>
                            <div class="row">
                                <label
                                    for="cash_flow_vat_account_id"
                                    class="col-lg-4 o_light_label"
                                />
                                <field
                                    name="cash_flow_vat_account_id"
                                    options="{'no_create': True}"
                                />
                            </div>
                        </div>
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>
