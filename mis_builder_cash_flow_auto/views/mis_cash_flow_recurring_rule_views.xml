<odoo>
    <record id="mis_cash_flow_recurring_rule_view_list" model="ir.ui.view">
        <field name="model">mis.cash_flow.recurring_rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="account_ids" widget="many2many_tags" />
                <field name="history_months" />
                <field name="day_of_month" />
                <field name="forecast_account_id" />
                <field name="monthly_amount" />
                <field name="currency_id" column_invisible="1" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>
    <record id="mis_cash_flow_recurring_rule_view_form" model="ir.ui.view">
        <field name="model">mis.cash_flow.recurring_rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Wages" />
                        </h1>
                    </div>
                    <group>
                        <group string="History">
                            <field name="account_ids" widget="many2many_tags" />
                            <field name="partner_ids" widget="many2many_tags" />
                            <field name="history_months" />
                            <field name="monthly_amount" />
                        </group>
                        <group string="Forecast">
                            <field name="day_of_month" />
                            <field name="forecast_account_id" />
                            <field name="partner_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="currency_id" invisible="1" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="mis_cash_flow_recurring_rule_view_search" model="ir.ui.view">
        <field name="model">mis.cash_flow.recurring_rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="account_ids" />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>
    <record id="mis_cash_flow_recurring_rule_action" model="ir.actions.act_window">
        <field name="name">Recurring Cash Flows</field>
        <field name="res_model">mis.cash_flow.recurring_rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Forecast a monthly cost or income, e.g. wages or rent
            </p>
            <p>
                The forecast is the monthly average of the chosen accounts over
                the past months. A month that already has postings on the
                accounts is skipped, as the postings are already in the cash
                flow.
            </p>
        </field>
    </record>
    <menuitem
        id="mis_cash_flow_recurring_rule_menu"
        parent="mis_builder.mis_report_finance_menu"
        action="mis_cash_flow_recurring_rule_action"
        sequence="24"
        groups="account.group_account_manager"
    />
</odoo>
